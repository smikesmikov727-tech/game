<div class="news-card">
	<div class="news-image">
		<a href="../news/new?id={id}" title="{new_name}">
			<img src="../{img}?v={cache}" alt="{new_name}">
			<div class="news-overlay">
				<i class="fas fa-arrow-right"></i>
			</div>
		</a>
	</div>
	<div class="news-content">
		<a href="../news/new?id={id}" title="{new_name}" class="news-title">{new_name}</a>
		<p class="news-excerpt">{short_text}</p>
		<div class="news-meta">
			<span><i class="far fa-calendar-alt"></i> {date}</span>
			<span><i class="far fa-eye"></i> {views}</span>
		</div>
	</div>
</div>
